# Runtime
NODE_ENV=development
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# REST API
API_HOST=0.0.0.0
API_PORT=4000
SESSION_COOKIE_NAME=nexvia_session
SESSION_TTL_DAYS=30
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-a-different-32-character-secret
TRUST_PROXY=false

# Collaboration gateway
COLLABORATION_HOST=0.0.0.0
COLLABORATION_PORT=4001
VITE_COLLABORATION_URL=ws://localhost:4001/collaboration
COLLABORATION_INTERNAL_URL=http://localhost:4001
COLLABORATION_INTERNAL_SECRET=replace-with-another-32-character-secret
COLLABORATION_REDIS_CHANNEL_PREFIX=nexvia:collaboration
COLLABORATION_RECONCILE_INTERVAL_MS=2000

# PostgreSQL / Prisma
POSTGRES_USER=nexvia
POSTGRES_PASSWORD=replace-local-password
POSTGRES_DB=nexvia
DATABASE_URL=postgresql://nexvia:replace-local-password@localhost:5432/nexvia?schema=public
TEST_DATABASE_URL=postgresql://nexvia:replace-local-password@localhost:5432/nexvia_test?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Web build: public values only
VITE_API_URL=http://localhost:4000/api/v1

# Password reset delivery
MAIL_TRANSPORT=log
MAIL_FROM=Orvyn Workspace <no-reply@example.test>
SEED_DEMO_DATA=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
