{
  "name": "aureva-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm run dev -w @aureva/web\" \"npm run dev -w @aureva/api\"",
    "build": "npm run build:packages && npm run build -w @aureva/api && npm run build -w @aureva/web",
    "build:packages": "npm run build -w @aureva/shared && npm run build -w @aureva/database",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "node tests/e2e/smoke.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:storage": "node scripts/verify-storage.mjs",
    "db:generate": "npm run db:generate -w @aureva/database",
    "db:migrate": "npm run db:migrate -w @aureva/database",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @aureva/database",
    "db:seed": "npm run db:seed -w @aureva/database",
    "services:up": "docker compose up -d postgres redis elasticsearch s3mock",
    "services:down": "docker compose down",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.1",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
