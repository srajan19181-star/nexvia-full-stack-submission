generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  CLOSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum UploadStatus {
  PRESIGNED
  VERIFIED
  REJECTED
}

model User {
  id String @id @default(cuid())
  email String @unique @db.VarChar(254)
  passwordHash String
  name String @db.VarChar(100)
  avatarUrl String?
  roles Role[] @default([CUSTOMER])
  status UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customerProfile CustomerProfile?
  vendor Vendor?
  sessions RefreshSession[]
  addresses Address[]
  carts Cart[]
  wishlist Wishlist?
  orders Order[]
  reviews Review[]
  notifications Notification[]
  tickets SupportTicket[]
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  supportMessages SupportMessage[]
  emailVerificationTokens EmailVerificationToken[]
  returnRequests ReturnRequest[] @relation("ReturnRequester")
  reviewedReturns ReturnRequest[] @relation("ReturnReviewer")
  disputes Dispute[] @relation("DisputeRequester")
  reviewedDisputes Dispute[] @relation("DisputeReviewer")
  requestedRefunds Refund[] @relation("RefundRequester")
  reviewedRefunds Refund[] @relation("RefundReviewer")
  mediaUploads MediaUpload[]
  platformSettings PlatformSetting[] @relation("PlatformSettingUpdater")
  couponRedemptions CouponRedemption[]
  auditLogs AuditLog[] @relation("AuditActor")
  @@index([status])
}

model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model RefreshSession {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  familyId String
  expiresAt DateTime
  revokedAt DateTime?
  replacedById String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([familyId])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model CustomerProfile {
  id String @id @default(cuid())
  userId String @unique
  phone String?
  dateOfBirth DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vendor {
  id String @id @default(cuid())
  ownerId String @unique
  storeName String
  slug String @unique
  description String
  legalName String
  taxIdentifier String
  logoUrl String?
  bannerUrl String?
  supportEmail String?
  accentColor String @default("#7A6248")
  returnPolicy String?
  shippingRules Json @default("{}")
  processingDays Int @default(3)
  status VendorStatus @default(PENDING)
  commissionBasisPoints Int @default(1000)
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  application VendorApplication?
  verification VendorVerification?
  payoutAccount VendorPayoutAccount?
  products Product[]
  vendorOrders VendorOrder[]
  coupons Coupon[]
  commissions Commission[]
  payouts Payout[]
  mediaUploads MediaUpload[]
  @@index([status])
}

model VendorApplication {
  id String @id @default(cuid())
  vendorId String @unique
  status VendorStatus @default(PENDING)
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewerId String?
  rejectionReason String?
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  @@index([status, submittedAt])
}

model VendorVerification {
  id String @id @default(cuid())
  vendorId String @unique
  identityStatus String @default("PENDING")
  taxStatus String @default("PENDING")
  documents Json @default("[]")
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorPayoutAccount {
  id String @id @default(cuid())
  vendorId String @unique
  provider String
  providerAccountId String @unique
  status String @default("PENDING")
  lastFour String?
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Address {
  id String @id @default(cuid())
  userId String
  label String
  name String
  line1 String
  line2 String?
  city String
  state String
  postalCode String
  countryCode String @db.Char(2)
  phone String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
  @@index([userId])
}

model Category {
  id String @id @default(cuid())
  parentId String?
  name String
  slug String @unique
  description String?
  imageUrl String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  attributes CategoryAttribute[]
  products Product[]
  @@index([parentId, sortOrder])
}

model CategoryAttribute {
  id String @id @default(cuid())
  categoryId String
  name String
  type String
  options Json @default("[]")
  required Boolean @default(false)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([categoryId, name])
}

model Brand {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  logoUrl String?
  products Product[]
}

model Product {
  id String @id @default(cuid())
  vendorId String
  categoryId String
  brandId String?
  name String
  slug String @unique
  description String
  basePrice Int
  currency String @default("INR") @db.Char(3)
  specifications Json @default("{}")
  status ProductStatus @default(DRAFT)
  averageRating Decimal @default(0) @db.Decimal(3,2)
  reviewCount Int @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images ProductImage[]
  wishlistItems WishlistItem[]
  orderItems OrderItem[]
  reviews Review[]
  @@index([vendorId, status])
  @@index([categoryId, status])
  @@index([status, publishedAt])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  sku String @unique
  name String
  price Int
  compareAtPrice Int?
  currency String @default("INR") @db.Char(3)
  attributes Json @default("{}")
  isActive Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]
  reservations InventoryReservation[]
  @@index([productId, isActive])
}

model ProductImage {
  id String @id @default(cuid())
  productId String
  url String
  altText String
  sortOrder Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, sortOrder])
}

model Inventory {
  id String @id @default(cuid())
  variantId String @unique
  quantity Int @default(0)
  reserved Int @default(0)
  lowStockThreshold Int @default(5)
  version Int @default(0)
  updatedAt DateTime @updatedAt
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model InventoryReservation {
  id String @id @default(cuid())
  variantId String
  orderId String
  quantity Int
  expiresAt DateTime
  releasedAt DateTime?
  createdAt DateTime @default(now())
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([variantId, orderId])
  @@index([expiresAt, releasedAt])
}

model Cart {
  id String @id @default(cuid())
  userId String
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  @@unique([userId, status])
}

model CartItem {
  id String @id @default(cuid())
  cartId String
  productVariantId String
  quantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  @@unique([cartId, productVariantId])
}

model Wishlist {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id String @id @default(cuid())
  wishlistId String
  productId String
  createdAt DateTime @default(now())
  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([wishlistId, productId])
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  userId String
  addressId String
  status OrderStatus @default(PENDING_PAYMENT)
  currency String @default("INR") @db.Char(3)
  subtotal Int
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  taxTotal Int @default(0)
  grandTotal Int
  couponCode String?
  idempotencyKey String @unique
  placedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  address Address @relation(fields: [addressId], references: [id], onDelete: Restrict)
  vendorOrders VendorOrder[]
  payments Payment[]
  history OrderStatusHistory[]
  reservations InventoryReservation[]
  refunds Refund[]
  couponRedemptions CouponRedemption[]
  returnRequests ReturnRequest[]
  disputes Dispute[]
  supportTickets SupportTicket[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model VendorOrder {
  id String @id @default(cuid())
  orderId String
  vendorId String
  status OrderStatus @default(PENDING_PAYMENT)
  subtotal Int
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  commissionTotal Int @default(0)
  vendorNet Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items OrderItem[]
  shipments Shipment[]
  commission Commission?
  payoutItems PayoutItem[]
  @@unique([orderId, vendorId])
  @@index([vendorId, status, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  vendorOrderId String
  productId String
  variantId String
  productName String
  variantName String
  sku String
  quantity Int
  unitPrice Int
  totalPrice Int
  currency String @db.Char(3)
  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  review Review?
  returnItems ReturnRequestItem[]
}

model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  fromStatus OrderStatus?
  toStatus OrderStatus
  note String?
  actorId String?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}

model Shipment {
  id String @id @default(cuid())
  vendorOrderId String
  carrier String
  trackingNumber String @unique
  trackingUrl String?
  shippedAt DateTime?
  deliveredAt DateTime?
  status String @default("LABEL_CREATED")
  lastEventAt DateTime?
  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  events ShipmentTrackingEvent[]
}

model ShipmentTrackingEvent {
  id String @id @default(cuid())
  shipmentId String
  providerEventId String @unique
  status String
  description String?
  location String?
  occurredAt DateTime
  payload Json @default("{}")
  createdAt DateTime @default(now())
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  @@index([shipmentId, occurredAt])
}

model Payment {
  id String @id @default(cuid())
  orderId String
  provider String
  providerPaymentId String? @unique
  providerIntentId String? @unique
  status PaymentStatus @default(REQUIRES_ACTION)
  amount Int
  currency String @db.Char(3)
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentEvent[]
  refunds Refund[]
  @@index([orderId, status])
}

model PaymentEvent {
  id String @id @default(cuid())
  paymentId String?
  providerEventId String @unique
  type String
  payload Json
  processedAt DateTime?
  createdAt DateTime @default(now())
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

model Refund {
  id String @id @default(cuid())
  orderId String
  paymentId String
  providerRefundId String? @unique
  amount Int
  reason String
  status RefundStatus @default(REQUESTED)
  requestedById String?
  reviewedById String?
  returnRequestId String? @unique
  reviewedAt DateTime?
  failureReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User? @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("RefundReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
}

model Commission {
  id String @id @default(cuid())
  vendorId String
  vendorOrderId String @unique
  subtotal Int
  basisPoints Int
  amount Int
  reversedAmount Int @default(0)
  currency String @db.Char(3)
  createdAt DateTime @default(now())
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
}

model Payout {
  id String @id @default(cuid())
  vendorId String
  providerPayoutId String? @unique
  amount Int
  currency String @db.Char(3)
  status PayoutStatus @default(PENDING)
  createdAt DateTime @default(now())
  paidAt DateTime?
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items PayoutItem[]
  @@index([vendorId, status])
}

model PayoutItem {
  id String @id @default(cuid())
  payoutId String
  vendorOrderId String
  amount Int
  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  @@unique([payoutId, vendorOrderId])
}

model Coupon {
  id String @id @default(cuid())
  vendorId String?
  code String @unique
  type DiscountType
  value Int
  minimumOrder Int @default(0)
  maximumDiscount Int?
  usageLimit Int?
  perUserLimit Int @default(1)
  startsAt DateTime
  expiresAt DateTime
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]
  @@index([active, startsAt, expiresAt])
}

model CouponRedemption {
  id String @id @default(cuid())
  couponId String
  userId String
  orderId String
  discountAmount Int
  createdAt DateTime @default(now())
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([couponId, userId])
}

model Review {
  id String @id @default(cuid())
  userId String
  productId String
  orderItemId String @unique
  rating Int
  title String
  body String
  status ReviewStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  @@unique([userId, productId])
  @@index([productId, status])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  message String
  data Json @default("{}")
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model SupportTicket {
  id String @id @default(cuid())
  userId String
  subject String
  message String
  orderId String?
  category String @default("GENERAL")
  assignedToId String?
  status TicketStatus @default(OPEN)
  priority String @default("NORMAL")
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages SupportMessage[]
  @@index([status, createdAt])
  @@index([assignedToId, status])
}

model SupportMessage {
  id String @id @default(cuid())
  ticketId String
  authorId String
  body String
  internal Boolean @default(false)
  createdAt DateTime @default(now())
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt])
}

model ReturnRequest {
  id String @id @default(cuid())
  orderId String
  userId String
  reviewerId String?
  status ReturnStatus @default(REQUESTED)
  reason String
  details String
  evidence Json @default("[]")
  resolutionNote String?
  returnCarrier String?
  returnTrackingNumber String?
  shippedAt DateTime?
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user User @relation("ReturnRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ReturnReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  items ReturnRequestItem[]
  refund Refund?
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ReturnRequestItem {
  id String @id @default(cuid())
  returnRequestId String
  orderItemId String
  quantity Int
  reason String?
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  @@unique([returnRequestId, orderItemId])
}

model Dispute {
  id String @id @default(cuid())
  orderId String
  userId String
  reviewerId String?
  status DisputeStatus @default(OPEN)
  subject String
  details String
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user User @relation("DisputeRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewer User? @relation("DisputeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  @@unique([orderId, userId])
  @@index([status, createdAt])
}

model MediaUpload {
  id String @id @default(cuid())
  vendorId String
  userId String
  key String @unique
  url String
  contentType String
  size Int
  status UploadStatus @default(PRESIGNED)
  presignedAt DateTime @default(now())
  verifiedAt DateTime?
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([vendorId, status])
}

model PlatformSetting {
  id String @id @default(cuid())
  key String @unique
  value Json
  description String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy User? @relation("PlatformSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model NewsletterSubscriber {
  id String @id @default(cuid())
  email String @unique @db.VarChar(254)
  status String @default("ACTIVE") @db.VarChar(24)
  source String @default("STOREFRONT") @db.VarChar(40)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, subscribedAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String?
  metadata Json @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model SearchOutbox {
  id String @id @default(cuid())
  aggregateType String
  aggregateId String
  operation String
  payload Json
  status OutboxStatus @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  processedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([status, availableAt])
}
