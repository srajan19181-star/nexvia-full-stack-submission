{
  "name": "@aureva/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": { ".": { "types": "./src/index.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "node ../../scripts/clean-directory.mjs dist && esbuild src/index.ts --bundle --platform=neutral --format=esm --outfile=dist/index.js --packages=external",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "zod": "^4.6.7" },
  "devDependencies": { "esbuild": "0.28.2", "typescript": "6.0.2", "vitest": "5.1.0" }
}
